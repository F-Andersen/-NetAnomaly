# Copy to .env and replace every change_me value. Never commit .env.
POSTGRES_DB=netanomaly
POSTGRES_USER=netanomaly
POSTGRES_PASSWORD=change_me_postgres

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana

# Train this run locally before starting the API. Keep it equal to --run-id.
MODEL_RUN_ID=local_seed42
# Model served by the API: lof_novelty (default) or isolation_forest.
MODEL_ALGORITHM=lof_novelty

# Host ports, bound to 127.0.0.1 only.
API_PORT=8000
POSTGRES_HOST_PORT=55432
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
